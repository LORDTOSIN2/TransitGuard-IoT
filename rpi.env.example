# =============================================================================
# TransitGuard IoT - Raspberry Pi 4 Environment Configuration Example
# =============================================================================
# File: /etc/transitguard.env  OR  .env in /home/pi/TransitGuard-IoT/
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your actual populated .env file to Git or public repositories.
# 2. NEVER put your Supabase service-role key or database password on the Raspberry Pi.
# 3. The Pi ONLY needs the device ingest token (TRANSITGUARD_DEVICE_TOKEN).
# =============================================================================

# 1. Supabase Project Base URL (Required)
SUPABASE_URL=https://hfzqfcuezuxcgaifxqok.supabase.co

# 2. Supabase Edge Function Ingestion Endpoint (Primary Telemetry Target)
SUPABASE_INGEST_URL=https://hfzqfcuezuxcgaifxqok.supabase.co/functions/v1/ingest-telemetry

# 3. Unique Vehicle / Device Identifier
# Must match the TRANSITGUARD_DEVICE_ID configured in Supabase Edge Function secrets
TRANSITGUARD_DEVICE_ID=BUS-101

# 4. Device Ingestion Authentication Token
# Must match the TRANSITGUARD_DEVICE_TOKEN configured in Supabase Edge Function secrets
# Replace with your actual secret device token:
TRANSITGUARD_DEVICE_TOKEN=tg-device-token-obu-default

# 5. Local Offline SQLite Buffer Path
# On Linux/RPi OS, this saves to the user's home directory
BUFFER_DB_PATH=/home/pi/.transitguard_buffer.db

# 6. Telemetry Publishing Interval (Seconds)
# Default is 10.0 seconds. For high-frequency tracking, set to 5.0 or 3.0
PUBLISH_INTERVAL_SEC=10.0

# 7. Maximum Packets Buffered Offline
# Prevents SD card / disk exhaustion during extended cellular/Wi-Fi outages
MAX_BUFFERED_PACKETS=5000

# 8. (Optional Fallback) Supabase Publishable / Anon Key
# Only used if direct REST ingestion fallback (/rest/v1/telemetry) is explicitly enabled
SUPABASE_PUBLISHABLE_KEY=sb_publishable_0DseTT82noxmCUmx74miOg_yGFH71TF
